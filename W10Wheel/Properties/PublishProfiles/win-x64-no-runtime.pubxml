<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent single-file build for distribution: the .NET 11 Desktop Runtime (x64) must
  be installed, and its updates (e.g. by Microsoft Update) apply without a new W10Wheel.
  dotnet publish W10Wheel/W10Wheel.fsproj -p:PublishProfile=win-x64-no-runtime
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\publish\win-x64-no-runtime\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
